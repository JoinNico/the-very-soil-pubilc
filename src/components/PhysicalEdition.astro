---
import { book } from '../data/site';
import Motifs from './Motifs.astro';

const imagePath = (filename: string) => `${import.meta.env.BASE_URL}images/${filename}`;
---

<section class='physical' id='physical-edition' aria-labelledby='physical-title'>
  <Motifs name='ribbon' class='physical-ribbon' />
  <div class='physical-inner'>
    <header class='section-heading'>
      <div>
        <p class='section-index'>03 / PHYSICAL EDITION</p>
        <h2 id='physical-title'>
          <span lang='zh'>中文实体书</span>
          <small></small>
        </h2>
      </div>
      <p class='edition-note'>采用 ISO B6（125 × 176 mm）开本，共 144 页。<br />正文按照长篇批评文本重新编排，并以粉色与紫色区分章节、页码及导航信息。</p>
    </header>

    <div class='edition-sequence'>
      <figure class='edition-figure chapter-opening'>
        <div class='image-frame image-frame-landscape'>
          <img
            src={imagePath('chapter-opening-spread.png')}
            width='1600'
            height='1000'
            loading='lazy'
            decoding='async'
            alt='《绝望即壤》章节起始页跨页'
          />
        </div>
        <figcaption>
          <span>01</span>
          <strong lang='en'>CHAPTER OPENING</strong>
          <small>章节起始页</small>
        </figcaption>
      </figure>

      <figure class='edition-figure part-system'>
        <div class='part-pages'>
          <div class='image-frame image-frame-page'>
            <img
              src={imagePath('part01-page.png')}
              width='739'
              height='1040'
              loading='lazy'
              decoding='async'
              alt='Part I 电视动画分隔页'
            />
          </div>
          <div class='image-frame image-frame-page'>
            <img
              src={imagePath('part02-page.png')}
              width='739'
              height='1040'
              loading='lazy'
              decoding='async'
              alt='Part II 外传漫画分隔页'
            />
          </div>
          <div class='image-frame image-frame-page'>
            <img
              src={imagePath('part03-page.png')}
              width='739'
              height='1040'
              loading='lazy'
              decoding='async'
              alt='Part III 叛逆的物语分隔页'
            />
          </div>
        </div>
        <figcaption>
          <span>02</span>
          <strong lang='en'>THREE PARTS</strong>
          <small>三个部分</small>
        </figcaption>
      </figure>

      <figure class='edition-figure body-text'>
        <div class='image-frame image-frame-landscape'>
          <img
            src={imagePath('body-text-spread.png')}
            width='1600'
            height='1000'
            loading='lazy'
            decoding='async'
            alt='《绝望即壤》普通正文双页'
          />
        </div>
        <figcaption>
          <span>03</span>
          <strong lang='en'>BODY TEXT</strong>
          <small>正文</small>
        </figcaption>
      </figure>

      <figure class='edition-figure detail-crop'>
        <div class='image-frame image-frame-detail'>
          <img
            src={imagePath('detail-crop.png')}
            width='1200'
            height='800'
            loading='lazy'
            decoding='async'
            alt='中文版页码、页眉与魔女文字排版细节'
          />
        </div>
        <figcaption>
          <span>04</span>
          <strong lang='en'>DETAILS</strong>
          <small>页码 / 页眉 / 魔女文字</small>
        </figcaption>
      </figure>

      <figure class='edition-figure cover-spread'>
        <div class='image-frame image-frame-cover'>
          <img
            src={imagePath('cover-spread.jpg')}
            width='1600'
            height='720'
            loading='lazy'
            decoding='async'
            alt='《绝望即壤》封底、书脊与封面展开图'
          />
        </div>
        <figcaption>
          <span>05</span>
          <strong lang='en'>COVER</strong>
          <small>封底 / 书脊 / 封面</small>
        </figcaption>
      </figure>
    </div>

    <dl class='book-specs' aria-label='实体书规格'>
      <div><dt>FORMAT</dt><dd>{book.format}</dd></div>
      <div><dt>EXTENT</dt><dd>{book.pages} 页</dd></div>
      <div><dt>EDITION</dt><dd>第一版</dd></div>
      <div><dt>YEAR</dt><dd>{book.editionYear}</dd></div>
    </dl>
  </div>
</section>

<style>
  .physical {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    color: var(--book-black);
    background: #fffafb;
  }

  .physical::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 0;
    opacity: 0.45;
    background-image:
      linear-gradient(color-mix(in srgb, var(--mami-gold) 5%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in srgb, var(--sayaka-blue) 5%, transparent) 1px, transparent 1px);
    background-size: 4.25rem 4.25rem;
  }

  .physical-inner {
    width: min(100% - 2rem, 76rem);
    margin-inline: auto;
    padding-block: clamp(6rem, 11vw, 10rem);
  }

  .section-heading {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(17rem, 0.65fr);
    align-items: end;
    gap: clamp(3rem, 9vw, 9rem);
  }

  .section-index {
    margin: 0 0 1.5rem;
    color: color-mix(in srgb, var(--mami-gold) 76%, var(--book-black));
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.2em;
  }

  h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.65rem, 5.2vw, 4.8rem);
    font-weight: 500;
    letter-spacing: 0.02em;
    line-height: 1.06;
  }

  h2 span,
  h2 small {
    display: block;
  }

  h2 small {
    margin-top: 0.75rem;
    color: var(--book-gray);
    font-family: var(--font-serif, serif);
    font-size: clamp(1.15rem, 2vw, 1.55rem);
    font-weight: 500;
    letter-spacing: 0.08em;
  }

  .edition-note {
    margin: 0;
    color: var(--book-gray);
    font-family: var(--font-serif, serif);
    font-size: 0.98rem;
    line-height: 1.9;
  }

  .edition-sequence {
    display: grid;
    gap: clamp(5rem, 11vw, 10rem);
    margin-top: clamp(4rem, 8vw, 7rem);
  }

  .edition-figure {
    margin: 0;
  }

  .edition-figure:nth-child(1) {
    --figure-accent: var(--madoka-pink);
  }

  .edition-figure:nth-child(2) {
    --figure-accent: var(--homura-violet);
  }

  .edition-figure:nth-child(3) {
    --figure-accent: var(--sayaka-blue);
  }

  .edition-figure:nth-child(4) {
    --figure-accent: var(--mami-gold);
  }

  .edition-figure:nth-child(5) {
    --figure-accent: var(--kyoko-red);
  }

  .image-frame {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(circle at 50% 50%, rgb(24 21 28 / 0.07), transparent 24%),
      #e9e2e2;
    box-shadow: 0 1.25rem 3.5rem rgb(24 21 28 / 0.11);
  }

  .image-frame::after {
    content: '';
    position: absolute;
    inset: 0;
    border: 1px solid rgb(24 21 28 / 0.14);
    border-top: 2px solid var(--figure-accent);
    pointer-events: none;
  }

  .image-frame img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .image-frame-landscape {
    aspect-ratio: 8 / 5;
  }

  .part-system {
    width: min(92%, 68rem);
  }

  .part-pages {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(0.75rem, 2.5vw, 2rem);
  }

  .image-frame-page {
    aspect-ratio: 739 / 1040;
  }

  .detail-crop {
    width: min(62%, 42rem);
    margin-left: auto;
  }

  .image-frame-detail {
    aspect-ratio: 3 / 2;
  }

  .body-text {
    width: 100%;
  }

  .cover-spread {
    width: min(88%, 66rem);
    margin-inline: auto;
  }

  .image-frame-cover {
    aspect-ratio: 20 / 9;
  }

  figcaption {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    gap: 0.2rem 0.8rem;
    width: fit-content;
    margin-top: 1rem;
    color: var(--book-gray);
    font-size: 0.74rem;
    letter-spacing: 0.1em;
    line-height: 1.5;
  }

  figcaption > span {
    grid-row: 1 / span 2;
    color: color-mix(in srgb, var(--figure-accent) 80%, var(--book-black));
    font-weight: 700;
  }

  figcaption strong {
    color: var(--book-black);
    font-weight: 700;
  }

  figcaption small {
    font-family: var(--font-serif, serif);
    font-size: 0.74rem;
    letter-spacing: 0.06em;
  }

  .book-specs {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin: clamp(5rem, 10vw, 9rem) 0 0;
    border-block: 1px solid var(--rule-faint);
  }

  .book-specs div {
    padding: 1.25rem 0;
  }

  .book-specs div + div {
    padding-left: clamp(1rem, 3vw, 2rem);
    border-left: 1px solid var(--rule-faint);
  }

  dt {
    margin: 0 0 0.35rem;
    color: var(--book-gray);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.14em;
  }

  dd {
    margin: 0;
    font-family: var(--font-serif, serif);
    font-size: clamp(0.84rem, 1.5vw, 1rem);
  }

  :global(.physical-ribbon) {
    position: absolute;
    z-index: -1;
    right: -6rem;
    bottom: 8rem;
    width: clamp(28rem, 60vw, 58rem);
    color: var(--ribbon-red);
    opacity: 0.07;
    transform: rotate(-9deg);
  }

  @media (max-width: 52rem) {
    .section-heading {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .edition-note {
      max-width: 39rem;
    }

    .part-system,
    .cover-spread {
      width: 100%;
    }

    .detail-crop {
      width: min(76%, 42rem);
    }
  }

  @media (max-width: 38rem) {
    .physical-inner {
      width: min(100% - 1.25rem, 76rem);
    }

    .edition-sequence {
      gap: 4.5rem;
    }

    .part-pages {
      grid-template-columns: 1fr 1fr;
    }

    .part-pages .image-frame:last-child {
      grid-column: 2;
    }

    .detail-crop {
      width: 84%;
    }

    .book-specs {
      grid-template-columns: 1fr 1fr;
    }

    .book-specs div:nth-child(3) {
      padding-left: 0;
      border-left: 0;
    }

    .book-specs div:nth-child(n + 3) {
      border-top: 1px solid var(--rule-faint);
    }
  }
</style>
