---
import { book } from '../data/site';
---

<figure class='book-figure' aria-labelledby='book-model-caption'>
  <a
    class='book-link'
    href='#physical-edition'
    aria-label={`查看《${book.title}》实体版信息`}
    aria-describedby='book-model-caption'
  >
    <span class='book' aria-hidden='true'>
      <span class='book-face book-back'></span>
      <span class='book-edge book-pages'></span>
      <span class='book-edge book-top'></span>
      <span class='book-face book-front'>
        <img
          class='cover-image'
          src='/images/cover.jpg'
          alt={`《${book.title}》封面`}
          loading='eager'
          decoding='async'
          draggable='false'
        />
      </span>
    </span>
  </a>
  <figcaption id='book-model-caption'>立体书封 · 选择后跳转至实体版信息</figcaption>
</figure>

<style>
  .book-figure {
    width: min(100%, 25rem);
    margin: 0 auto;
    text-align: center;
  }

  .book-link {
    --book-depth: clamp(1.35rem, 4.2vw, 2.25rem);
    display: grid;
    place-items: center;
    width: 100%;
    min-height: clamp(26rem, 54vw, 37rem);
    perspective: 1000px;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }

  .book {
    position: relative;
    display: block;
    width: clamp(13.75rem, 29vw, 19.25rem);
    aspect-ratio: 125 / 176;
    transform: rotateY(-28deg) rotateX(1.5deg);
    transform-style: preserve-3d;
    transition: transform 700ms cubic-bezier(0.2, 0.72, 0.2, 1), filter 700ms ease;
    animation: book-arrival 1.1s cubic-bezier(0.2, 0.72, 0.2, 1) both;
    filter: drop-shadow(1.25rem 1.5rem 1.35rem rgb(24 21 28 / 0.22));
  }

  .book-link:hover .book,
  .book-link:focus-visible .book {
    transform: rotateY(0deg) rotateX(0deg) translateY(-0.3rem);
    filter: drop-shadow(0.65rem 1.3rem 1.3rem rgb(24 21 28 / 0.18));
  }

  .book-link:focus-visible {
    outline: 2px solid var(--homura-violet, #6f4aa8);
    outline-offset: 0.35rem;
  }

  .book-face,
  .book-edge {
    position: absolute;
    display: block;
    backface-visibility: hidden;
  }

  .book-front,
  .book-back {
    inset: 0;
    overflow: hidden;
    border-radius: 0.2rem 0.35rem 0.35rem 0.2rem;
  }

  .book-front {
    z-index: 2;
    padding: 0;
    color: var(--book-black, #18151c);
    background: #fffafc;
    border: 1px solid rgb(24 21 28 / 0.16);
    transform: translateZ(calc(var(--book-depth) / 2));
  }

  .cover-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    user-select: none;
    -webkit-user-drag: none;
  }

  .book-back {
    background:
      linear-gradient(90deg, rgb(24 21 28 / 0.13), transparent 8%),
      var(--book-pale, #fff4f8);
    border: 1px solid rgb(24 21 28 / 0.16);
    transform: rotateY(180deg) translateZ(calc(var(--book-depth) / 2));
  }

  .book-pages {
    top: 0.35%;
    right: calc(var(--book-depth) / -2);
    width: var(--book-depth);
    height: 99.3%;
    background:
      repeating-linear-gradient(90deg, #e4dbd8 0 1px, #fffdfb 1px 3px),
      #fffdfb;
    border-block: 1px solid rgb(24 21 28 / 0.12);
    transform: rotateY(90deg);
  }

  .book-top {
    top: calc(var(--book-depth) / -2);
    left: 0.45%;
    width: 99.1%;
    height: var(--book-depth);
    background: repeating-linear-gradient(0deg, #e9dfdc 0 1px, #fffdfb 1px 3px);
    transform: rotateX(90deg);
  }

  .cover-grid {
    position: absolute;
    inset: 0;
    opacity: 0.2;
    background-image:
      linear-gradient(rgb(111 74 168 / 0.12) 1px, transparent 1px),
      linear-gradient(90deg, rgb(232 77 138 / 0.1) 1px, transparent 1px);
    background-size: 12.5% 9%;
    mask-image: linear-gradient(to bottom, transparent, black 18%, transparent 85%);
  }

  .cover-eyebrow {
    z-index: 1;
    color: var(--book-gray, #716b75);
    font-family: var(--font-sans, sans-serif);
    font-size: clamp(0.43rem, 0.9vw, 0.62rem);
    font-weight: 650;
    letter-spacing: 0.24em;
  }

  :global(.cover-gems) {
    z-index: 1;
    align-self: end;
    width: 52%;
    color: var(--madoka-pink, #e84d8a);
    filter: drop-shadow(1.65rem 0 0 rgb(111 74 168 / 0.24));
  }

  .cover-title {
    z-index: 1;
    margin-top: 3%;
    font-family: var(--font-display, var(--font-serif, serif));
    font-size: clamp(1.75rem, 4vw, 2.65rem);
    font-weight: 650;
    letter-spacing: 0.11em;
    line-height: 1.05;
    white-space: nowrap;
  }

  .cover-rule {
    z-index: 1;
    width: 43%;
    height: 1px;
    margin: 7% 0 5%;
    background: linear-gradient(90deg, var(--madoka-pink, #e84d8a) 0 47%, transparent 47% 53%, var(--homura-violet, #6f4aa8) 53%);
  }

  .cover-subtitle {
    z-index: 1;
    max-width: 92%;
    color: var(--book-gray, #716b75);
    font-family: var(--font-serif, serif);
    font-size: clamp(0.59rem, 1.3vw, 0.85rem);
    line-height: 1.65;
    text-align: center;
  }

  .cover-rune {
    z-index: 1;
    margin-top: 4%;
    color: var(--homura-violet, #6f4aa8);
    font-family: "Madoka Runes", var(--font-sans, sans-serif);
    font-size: clamp(0.38rem, 0.8vw, 0.52rem);
    letter-spacing: 0.1em;
    opacity: 0.65;
    text-align: center;
    text-transform: uppercase;
  }

  .cover-credits {
    z-index: 1;
    align-self: end;
    width: 100%;
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-top: 1px solid rgb(113 107 117 / 0.34);
    padding-top: 6%;
    font-family: var(--font-serif, serif);
    font-size: clamp(0.55rem, 1.15vw, 0.76rem);
  }

  .cover-credits > span {
    display: grid;
    gap: 0.15rem;
  }

  .cover-credits > span + span {
    border-left: 1px solid rgb(113 107 117 / 0.3);
  }

  .cover-credits small {
    color: var(--book-gray, #716b75);
    font-family: var(--font-sans, sans-serif);
    font-size: 0.66em;
    font-weight: 650;
    letter-spacing: 0.12em;
  }

  figcaption {
    max-width: 24rem;
    margin: -0.25rem auto 0;
    color: var(--book-gray, #716b75);
    font-size: 0.7rem;
    line-height: 1.55;
  }

  @keyframes book-arrival {
    from {
      opacity: 0;
      transform: rotateY(0deg) rotateX(0deg) translateY(1.25rem);
    }
    to {
      opacity: 1;
      transform: rotateY(-28deg) rotateX(1.5deg);
    }
  }

  @media (hover: none) {
    .book {
      transform: rotateY(-18deg) rotateX(1deg);
      animation-name: book-arrival-touch;
    }

    .book-link:hover .book,
    .book-link:focus-visible .book {
      transform: rotateY(-18deg) rotateX(1deg);
    }

    @keyframes book-arrival-touch {
      from {
        opacity: 0;
        transform: rotateY(0deg) translateY(1rem);
      }
      to {
        opacity: 1;
        transform: rotateY(-18deg) rotateX(1deg);
      }
    }
  }

  @media (max-width: 40rem) {
    .book-link {
      min-height: 29rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .book {
      animation: none;
      transition: none;
    }
  }

  @supports not (transform-style: preserve-3d) {
    .book-link {
      perspective: none;
    }

    .book {
      transform: none;
      filter: drop-shadow(0.7rem 1rem 1.1rem rgb(24 21 28 / 0.18));
    }

    .book-link:hover .book,
    .book-link:focus-visible .book {
      transform: translateY(-0.2rem);
    }

    .book-back,
    .book-edge {
      display: none;
    }

    .book-front {
      transform: none;
    }
  }
</style>
